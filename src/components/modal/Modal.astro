---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<'div'> {
    open?: boolean;
    nomotion?: boolean;
}

const { open = false, nomotion, ...props } = Astro.props;
---

<div 
    x-data={`{ open: ${open}, ${nomotion === undefined ? "" : `nomotion: ${nomotion},`} }`}
    @keydown.escape.window="open = false"
    {...props}
>
    <slot />
</div>
