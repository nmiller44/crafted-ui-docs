---
import { classNames } from "../../utils/classNames"
import type { HTMLAttributes } from "astro/types";
import PageHeader from "./PageHeader.astro";

interface Props extends HTMLAttributes<'div'> {
    title?: string;
    subtitle?: string;
    className?: string;
}

const { 
    title, 
    subtitle, 
    className, 
    ...props 
} = Astro.props;
---
<div class={classNames("w-full space-y-8 md:space-y-12", className)} {...props}>
    { (title || subtitle) &&
        <PageHeader 
            title={title} 
            subtitle={subtitle} 
        />
    }
    <slot />
</div>
