---
import { classNames } from "@/utils/classNames";

export interface Props {
    inline?: boolean;
    nocolon?: boolean;
    class?: string;
}

const { inline = false, nocolon = false, class: className, ...props } = Astro.props;
---

<dt class={classNames(
    "text-muted-foreground",
    inline ? (nocolon ? "" : "after:content-[':']") : "font-semibold",
    className
)} {...props}>
    <slot />
</dt>
