---
import { classNames } from "@/utils/classNames";
import DescListHeader from "./DescListHeader.astro";

export interface Props {
    title?: string;
    subtitle?: string;
    inline?: boolean;
    wrapperClassName?: string;
    class?: string;
}

const { title, subtitle, inline = false, wrapperClassName, class: className, ...props } = Astro.props;
---

<div class={classNames("space-y-6", wrapperClassName)}>
    {title && <DescListHeader title={title} subtitle={subtitle} />}
    <dl class={classNames(
        "grid grid-cols-1 sm:grid-cols-2 md:grid-cols-12 gap-x-6 gap-y-6 text-sm leading-5 text-foreground",
        inline && "[&>[data-desclist-item]]:flex [&>[data-desclist-item]]:items-center [&>[data-desclist-item]]:gap-x-2 [&>[data-desclist-item]]:space-y-0 [&>[data-desclist-item]>dt]:after:content-[':'] [&>[data-desclist-item]>dt]:flex-shrink-0 [&>[data-desclist-item]>dt]:text-muted-foreground [&>[data-desclist-item]>dt]:font-normal [&>[data-desclist-item]>dd]:flex-1",
        className
    )} {...props}>
        <slot />
    </dl>
</div>
