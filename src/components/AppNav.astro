---
import DarkToggle from "@components/DarkToggle.astro";
import Navbar from "@components/navbar/Navbar.astro";
import NavbarToggle from "@components/navbar/NavbarToggle.astro";
import SidebarContent from "@components/SidebarContent.astro";
import SidebarSection from "@components/SidebarSection.astro";
import SidebarSectionContent from "@components/SidebarSectionContent.astro";
import SidebarSectionContentItem from "@components/SidebarSectionContentItem.astro";
import SidebarSectionHeader from "@components/SidebarSectionHeader.astro";
import Tablist from "@components/tablist/Tablist.astro";
import TablistItem from "@components/tablist/TablistItem.astro";
import IconStorybook from "@components/icons/IconStorybook.astro";
import IconNpm from "@components/icons/IconNpm.astro";
import IconGithub from "@components/icons/IconGithub.astro";
import { classNames } from "@utils/classNames";
import { getLinks } from "@data/links";
import { sidebarLinks } from "@data/sidebar";

const links = getLinks();
const currentPath = Astro.url.pathname;
const navActionClass = classNames(
  "inline-flex items-center justify-center rounded-md",
  "border-0 bg-transparent text-primary",
  "focus-visible:outline-none",
  "transition-[background-color,box-shadow,transform,opacity] duration-200",

  // Hover Animation
  "hover:[text-shadow:0.5px_0_0_currentColor] focus-visible:[text-shadow:0.5px_0_0_currentColor]",
  "hover:-translate-y-1 focus-visible:-translate-y-1",
  "[&>svg]:transition-transform [&>svg]:duration-200",
  "hover:[&>svg]:scale-110 focus-visible:[&>svg]:scale-110",

  "disabled:opacity-50 disabled:pointer-events-none"
);
---  
<Navbar> 
    <div class="relative flex items-center justify-between py-2">
      <div class="flex space-x-4">
        <NavbarToggle class="" />

        <div class="flex flex-shrink-0 items-center">
          <a href="/" class="flex items-center font-bold text-primary">
              <svg class="h-7 w-7" id="crafted-logo" fill="currentColor" xmlns="http://www.w3.org/2000/svg" version="1.1" viewBox="0 0 176.4 147.6">
                  <path d="M63.8,110c-.8,0-1.6,0-2.5-.3-9.5-2.3-10.2-14.1-11.1-29.1-.8-13.4-1.9-31.7-10.3-36.5-5.1-3-13.9-1.4-25.3,4.6l-5.8,3-6.1-11.6,5.8-3c15.8-8.2,28.6-9.7,37.9-4.3,14.5,8.3,15.8,29.8,16.8,47,.3,5.1.7,12.2,1.7,15.9,1.4-1.3,3.8-4,7.1-9.3l3.5-5.5,11.1,7-3.5,5.5c-5,7.9-11.6,16.6-19.4,16.6Z"/>
                  <rect x="35.8" y="80.9" width="155.4" height="13.1" transform="translate(-29.2 101) rotate(-43)"/>
                  <path d="M107.8,49.6c-4.4,0-8.7-1.2-12.4-3.6-5.9-3.8-9.7-10.3-10.4-17.9-.8-7.6,1.8-15.2,6.9-20.1,7.4-7.2,19.6-8.6,29.5-3.4l5.8,3-6.1,11.6-5.8-3c-5-2.6-10.9-2.2-14.3,1.2-2.3,2.2-3.4,5.7-3,9.4.4,3.5,2,6.6,4.5,8.2,3.8,2.5,9.5,1.8,13.9-1.7l5.1-4.1,8.1,10.3-5.1,4.1c-5,4-10.9,6-16.7,6Z"/>
                  <path d="M63.8,110c-.8,0-1.6,0-2.5-.3-9.5-2.3-10.2-14.1-11.1-29.1-.8-13.4-1.9-31.7-10.3-36.5-5.1-3-13.9-1.4-25.3,4.6l-5.8,3-6.1-11.6,5.8-3c15.8-8.2,28.6-9.7,37.9-4.3,14.5,8.3,15.8,29.8,16.8,47,.3,5.1.7,12.2,1.7,15.9,1.4-1.3,3.8-4,7.1-9.3l3.5-5.5,11.1,7-3.5,5.5c-5,7.9-11.6,16.6-19.4,16.6Z"/>
                  <rect x="35.8" y="80.9" width="155.4" height="13.1" transform="translate(-29.2 101) rotate(-43)"/>
                  <path d="M107.8,49.6c-4.4,0-8.7-1.2-12.4-3.6-5.9-3.8-9.7-10.3-10.4-17.9-.8-7.6,1.8-15.2,6.9-20.1,7.4-7.2,19.6-8.6,29.5-3.4l5.8,3-6.1,11.6-5.8-3c-5-2.6-10.9-2.2-14.3,1.2-2.3,2.2-3.4,5.7-3,9.4.4,3.5,2,6.6,4.5,8.2,3.8,2.5,9.5,1.8,13.9-1.7l5.1-4.1,8.1,10.3-5.1,4.1c-5,4-10.9,6-16.7,6Z"/>
              </svg>
              <span class="ml-2 text-lg">CraftedUI</span>
          </a>
        </div>
      </div>
      <div class="grow">
        <div class="hidden lg:ml-8 lg:block">
          <Tablist>
            { links.map((link) => (
              <TablistItem>
                <a href={link.href} class={currentPath.startsWith(link.href) ? "active" : ""}>
                  {link.title}
                </a>  
              </TablistItem>
            ))}            
          </Tablist>
        </div>
      </div>
      <div class="flex space-x-4 items-center">
        <a
          class={navActionClass}
          href="https://storybook.crafted-ui.com"
          rel="noopener noreferrer"
          target="_blank"
          aria-label="Storybook"
          title="Storybook"
        >
          <IconStorybook className="size-5 shrink-0" />
          <span class="sr-only">Storybook</span>
        </a>
        <a
          class={navActionClass}
          href="https://www.npmjs.com/package/crafted-ui"
          rel="noopener noreferrer"
          target="_blank"
          aria-label="npm"
          title="npm"
        >
          <IconNpm className="size-4 shrink-0" />
          <span class="sr-only">npm</span>
          <span class="ml-1.5 text-sm">0.2.2</span>
        </a>
        <a
          class={navActionClass}
          href="https://github.com/nmiller44/crafted-ui"
          rel="noopener noreferrer"
          target="_blank"
          aria-label="GitHub"
          title="GitHub"
        >
          <IconGithub className="size-5 shrink-0" />
          <span class="sr-only">GitHub</span>
        </a>
        <div class="flex items-center"><DarkToggle className={navActionClass} /></div>
      </div>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div class="hidden lg:hidden" id="mobile-menu">
    <div class="space-y-1 px-2 pb-3 pt-2">
        { links.map((link) => (
            <a href={link.href} 
               class={currentPath.startsWith(link.href) 
                 ? "block rounded-md px-3 py-2 text-base font-medium bg-secondary text-secondary-foreground"
                 : "block rounded-md px-3 py-2 text-base font-medium text-primary hover:bg-secondary hover:text-secondary-foreground"}>
              {link.title}
            </a>  
            )
        )}
    </div>

    <!-- Mobile Sidebar Nav -->
    <div class="space-y-1 px-2">
      <SidebarContent>
        { sidebarLinks.map((sect) => (
            <SidebarSection>
                <SidebarSectionHeader>{ sect.title }</SidebarSectionHeader>
                <SidebarSectionContent>
                    { sect.items.map((item) => (
                        <SidebarSectionContentItem href={item.href}>{item.title}</SidebarSectionContentItem>
                    ))}
                </SidebarSectionContent>
            </SidebarSection>                       
        ))}
      </SidebarContent>
    </div>
  </div>
</Navbar>   

<script is:inline>
    const mobileButton = document.getElementById('mobile-menu-button');
    mobileButton?.addEventListener("click", () => {

        const menuContainer = document.getElementById('mobile-menu');
        menuContainer.classList.toggle("hidden")
        
        const mobileMenuOpen = document.getElementById('mobile-menu-open');
        mobileMenuOpen.classList.toggle("hidden")

        const mobileMenuClosed = document.getElementById('mobile-menu-closed');
        mobileMenuClosed.classList.toggle("hidden")
    })
</script>
