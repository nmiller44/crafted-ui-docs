---
import { classNames } from "@/utils/classNames";

interface Props {
    size?: "xs" | "sm" | "md" | "lg";
    clr?: "current" | "foreground" | "primary" | "muted" | "secondary" | "accent" | "destructive" | "danger" | "warning" | "success" | "info";
    label?: string;
    className?: string;
}

const { size = "md", clr = "current", label = "Loading", className, ...props } = Astro.props;

const sizeStyle = {
    xs: "size-3 border-[1.5px]",
    sm: "size-4 border-2",
    md: "size-5 border-2",
    lg: "size-6 border-[3px]",
};

const colorStyle = {
    current: "text-current",
    foreground: "text-foreground",
    primary: "text-primary",
    muted: "text-muted-foreground",
    secondary: "text-secondary",
    accent: "text-accent",
    destructive: "text-destructive",
    danger: "text-danger",
    warning: "text-warning",
    success: "text-success",
    info: "text-info",
};
---

<span
    role="status"
    aria-live="polite"
    class={classNames(
        "inline-block shrink-0 rounded-full animate-spin",
        "border-current border-r-transparent",
        sizeStyle[size],
        colorStyle[clr],
        className
    )}
    {...props}
>
    <span class="sr-only">{label}</span>
</span>
