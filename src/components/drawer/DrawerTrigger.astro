---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"div"> {
    handle?: string;
}

const { handle, class: className, ...props } = Astro.props;
const clickExpression = handle
    ? `$dispatch('crafted-drawer-open', ${JSON.stringify(handle)})`
    : "open = true";
---

<div
    class:list={["inline-block", className]}
    role="button"
    tabindex="0"
    @click={clickExpression}
    @keydown.enter.prevent={clickExpression}
    @keydown.space.prevent={clickExpression}
    {...props}
>
    <slot />
</div>